CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=



#   dev:  http://localhost:3000
#   prod: https://your-domain.com
SITE_URL=http://localhost:3000

# Signing key for sessions and tokens. Generate with:
#   openssl rand -base64 32
# Use a DIFFERENT one for the dev and production Convex deployments.
BETTER_AUTH_SECRET=


# Optional. Extra origins allowed to complete a sign-in, comma separated.
# Needed for Vercel preview deployments, which get a new URL per branch.
TRUSTED_ORIGINS=


# --- [CONVEX] Google sign-in ------------------------------------------------
# From console.cloud.google.com > APIs & Services > Credentials
#   > Create OAuth client ID > Web application
#
# Authorised redirect URIs must contain exactly this, one line per environment:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
#
# Authorised JavaScript origins:
#   http://localhost:3000
#   https://your-domain.com
#
# Leave both blank and the Google button stays wired but inactive; email and
# password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- [CONVEX] Email delivery for the one-time codes -------------------------
# From resend.com/api-keys. Needs "Sending access" only.
#
# Leave this blank during development and the six digit code is printed to the
# Convex log instead of being emailed, so you can build the flow before DNS is
# sorted out.

# QUOTE THIS VALUE when using `npx convex env set`. Unquoted, the shell reads
# the "<" as a redirect and silently stores a broken sender that Resend 422s:
#   npx convex env set EMAIL_FROM 'PlayWhatever <hello@your-domain.com>'
#
# The domain here must match a domain you verified at resend.com/domains,
# character for character. Until you have one,
# Resend's shared sender works for testing but only delivers to the address
# that owns the Resend account:
#   PlayWhatever <onboarding@resend.dev>
RESEND_API_KEY=
EMAIL_FROM=


# --- [NEXT, Vercel only] Deploy key -----------------------------------------
# Only set this in the Vercel dashboard, never in .env.local. It lets the
# Vercel build push your Convex functions before building the frontend.
# Create with: npx convex dashboard  > Settings > Generate production deploy key
CONVEX_DEPLOY_KEY=
